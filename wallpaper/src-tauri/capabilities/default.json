{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Wallpaper windows",
  "windows": ["background", "interaction", "settings"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "dialog:allow-open"
  ]
}
