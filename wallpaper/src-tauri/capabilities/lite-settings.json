{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "lite-settings",
  "description": "Lite wallpaper, animation, startup and appearance controls",
  "windows": ["settings"],
  "permissions": [
    "dialog:allow-open",
    "allow-lite-settings-get",
    "allow-lite-settings-save",
    "allow-lite-image-import",
    "allow-set-autostart",
    "allow-autostart-status",
    "allow-start-settings-drag",
    "allow-hide-settings-window"
  ]
}

