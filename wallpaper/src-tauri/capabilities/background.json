{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "background",
  "description": "WorkerW wallpaper host and its private chat surface",
  "windows": ["background"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-app-snapshot",
    "allow-desktop-displays",
    "allow-select-backend",
    "allow-dispatch-app-action",
    "allow-show-deepseek-login",
    "allow-release-native-bootstrap",
    "allow-deepseek-web-ensure",
    "allow-deepseek-web-status",
    "allow-deepseek-web-history",
    "allow-open-settings-window",
    "allow-scan-dsh-paths",
    "allow-begin-interaction-region-session",
    "allow-update-interaction-regions",
    "allow-desktop-layout-metrics",
    "allow-send-chat",
    "allow-cancel-chat",
    "allow-connect-harness",
    "allow-harness-history",
    "allow-harness-presets",
    "allow-harness-set-preset",
    "allow-harness-controls",
    "allow-harness-set-permission",
    "allow-api-history",
    "allow-probe-harness",
    "allow-launch-dsh",
    "allow-managed-dsh-status",
    "allow-appearance-resolve-asset"
  ]
}
