{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dsh-wallpaper",
  "version": "0.2.0",
  "identifier": "com.dsh.wallpaper",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5177",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "background", "title": "DSH Wallpaper", "url": "index.html?surface=background", "fullscreen": true, "decorations": false, "resizable": false, "focus": false, "skipTaskbar": true },
      { "label": "interaction", "title": "DSH Wallpaper Chat", "width": 760, "height": 720, "decorations": false, "transparent": true, "alwaysOnTop": true, "skipTaskbar": true, "visible": false }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Entertainment",
    "shortDescription": "DeepSeek interactive desktop wallpaper",
    "icon": [],
    "resources": ["../public/personas/wake-frames/variant-anima/sleep.png"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
