<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:virtualization="http://schemas.microsoft.com/appx/manifest/virtualization/windows10"
  IgnorableNamespaces="uap uap5 uap10 rescap virtualization">
  <Identity Name="com.dsh.wallpaper.lite" Publisher="CN=DSH Wallpaper Test" Version="0.1.2.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>DSH Wallpaper Lite</DisplayName>
    <PublisherDisplayName>DSH Wallpaper Test</PublisherDisplayName>
    <Description>Lightweight Windows lock-screen and desktop wallpaper.</Description>
    <Logo>Assets\StoreLogo.png</Logo>
    <!-- 与正式版同样的原因：登录后自动启动写在 HKCU 的 Run 键里，包内默认的写入虚拟化
         会让应用读到的状态和 Windows 登录时执行的状态不一致。 -->
    <virtualization:RegistryWriteVirtualization>
      <virtualization:ExcludedKeys>
        <virtualization:ExcludedKey>HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Run</virtualization:ExcludedKey>
      </virtualization:ExcludedKeys>
    </virtualization:RegistryWriteVirtualization>
  </Properties>
  <Resources><Resource Language="zh-cn" /></Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
    <PackageDependency Name="Microsoft.VCLibs.140.00.UWPDesktop" Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" MinVersion="14.0.0.0" />
  </Dependencies>
  <Capabilities><rescap:Capability Name="runFullTrust" /><rescap:Capability Name="unvirtualizedResources" /></Capabilities>
  <Applications>
    <Application Id="WallpaperLite" Executable="dsh-wallpaper-lite.exe" uap10:RuntimeBehavior="packagedClassicApp" uap10:TrustLevel="mediumIL">
      <uap:VisualElements DisplayName="DSH Wallpaper Lite" Description="Lightweight lock-screen and desktop wallpaper" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" BackgroundColor="transparent" />
      <!-- 与正式版同样的层级要求：uap5:StartupTask 必须在 Extensions 里，
           否则 Windows 不注册任务，GetAsync 只会回参数错误。 -->
      <Extensions>
        <uap5:Extension Category="windows.startupTask" Executable="dsh-wallpaper-lite.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="DshWallpaperStartup" Enabled="false" DisplayName="DSH Wallpaper Lite" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
